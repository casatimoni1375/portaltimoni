# Credenciais OAuth do Google Cloud Console (ver README.md para o passo a passo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Único email autorizado a entrar no portal
AUTHORIZED_EMAIL=mcrodini@gmail.com

# ID da agenda secundária "TIMONI AGENDA" (não é secreto, mas fica aqui para
# poder trocar sem alterar código). Valor padrão já preenchido em
# lib/google-calendar.ts caso essa variável não seja definida.
TIMONI_CALENDAR_ID=28fddf65c061d4f277f8ee4ddee48d5118d71dadf3e45de3443a3fd898b79356@group.calendar.google.com

# Opcional — só para o Painel Timoni conseguir mostrar a agenda de hoje. Ver
# seção 6 do README.md para o passo a passo de como obter/gerar os dois valores.
GOOGLE_REFRESH_TOKEN=
DATABASE_URL=
PAINEL_TIMONI_TOKEN=

# Configuração da candidata atual: valores reais devem ficar somente no servidor.
# AUTH_SECRET é o nome usado no projeto Vercel atual; não gerar segredo novo por cópia deste modelo.
AUTH_SECRET=
# Mesmo token configurado nas propriedades do Apps Script do Motorista.
MOTORISTA_API_TOKEN=
# Endpoint /exec da implantação correta, ainda sujeito a homologação.
MOTORISTA_WEBAPP_URL=
# Usar uma das duas opções para a configuração central do Gemini.
GEMINI_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
# Manter a prévia antiga de credenciais próprias desligada no modelo aprovado atual.
PORTAL_INDIVIDUAL_LOGIN_ENABLED=false

# Token exclusivo do acesso técnico de leitura usado no monitoramento de Leads.
# Gerar com: openssl rand -hex 32
LEADS_MONITOR_TOKEN=
